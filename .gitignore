# Dependencias
node_modules/

# Variables de entorno: cualquier .env* puede tener credenciales (.env.local, .env.qa, .env.backup, etc.).
# Lo único que va al repositorio son los .env.example.
.env
.env.*
!.env.example

# Build outputs
dist/
build/
.expo/
.next/
coverage/
*.tsbuildinfo

# SonarQube (carpeta de trabajo local del scanner)
.scannerwork/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Sistema operativo
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# Turbo cache
.turbo/

# Prisma
apps/backend/prisma/migrations/*.sql.bak

# Documentación - excepto archivos base del proyecto)
!Documentacion/Doc_DB.md
!Documentacion/Gantt.html

# Claude Code (generado por el entorno del SDK)
.claude/skills/
.claude/settings.local.json
.patches/

# Archivos de agentes de IA (locales, no se versionan)
/.agents/
/AGENTS.md

# Guías de prueba personales (no se versionan)
/docs/guia-prueba-celulares.md
