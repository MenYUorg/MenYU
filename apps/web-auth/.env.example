# web-auth (docs/auth/specs/auth.md, Fase 3). Copiar a .env.local, que git ignora.
# Valores de staging y producción: docs/auth/VariablesACambiar.md.

# API. Por defecto /api, que el servidor de Vite reenvía a BACKEND_URL (http://localhost:3000 si no se define).
VITE_API_URL=/api

# Proyecto de Supabase (Project Settings → API). La publishable key es pública: va en el bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Dominio de la cookie de sesión compartida (.menyu.local en local). Se usa desde la Fase 4.
VITE_AUTH_COOKIE_DOMAIN=.menyu.local
