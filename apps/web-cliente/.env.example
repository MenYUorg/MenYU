# web-cliente (la app del comensal). Copiar a .env.local, que git ignora.
# Valores de staging y producción: docs/auth/VariablesACambiar.md.

# API. Por defecto /api, que el servidor de Vite reenvía a BACKEND_URL (http://localhost:3000 si no se define).
# Socket.io también sale por este servidor (/socket.io), así que no hace falta VITE_WS_URL en local.
VITE_API_URL=/api

# web-auth: a dónde va quien es personal de un restaurante y escribe sus datos en /auth, el login del comensal
# (docs/auth/specs/auth.md, Fase 4). Si falta, sale del dominio de esta app (mesa.<ambiente> → auth.<ambiente>).
# El comensal no la usa: su sesión es la de la mesa (QR o PIN), y su cuenta llega en la Fase 4b.
VITE_AUTH_URL=http://auth.menyu.local:5173
