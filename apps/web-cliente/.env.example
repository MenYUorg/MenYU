# web-cliente (la app del comensal). Copiar a .env.local, que git ignora.
# Valores de staging y producción: docs/auth/VariablesACambiar.md.

# API. Por defecto /api, que el servidor de Vite reenvía a BACKEND_URL (http://localhost:3000 si no se define).
# Socket.io también sale por este servidor (/socket.io), así que no hace falta VITE_WS_URL en local.
VITE_API_URL=/api

# web-auth: donde el cliente inicia sesión o crea su cuenta (Fase 4b), y a donde va quien es personal de un restaurante
# y escribe sus datos en /auth (Fase 4). Si falta, sale del dominio de esta app (mesa.<ambiente> → auth.<ambiente>).
VITE_AUTH_URL=http://auth.menyu.local:5173

# La cuenta opcional del cliente (docs/auth/specs/auth.md, Fase 4b): el proyecto de Supabase (Project Settings → API;
# la publishable key es pública) y el dominio de la cookie de sesión compartida con web-auth (.menyu.local en local).
# Sin estas variables la app funciona igual, sin cuentas: el QR y el PIN entran como invitado.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_AUTH_COOKIE_DOMAIN=.menyu.local
