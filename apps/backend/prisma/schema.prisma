generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// MARCA Y SUCURSALES
// ─────────────────────────────────────────────

model Marca {
  id         String       @id @default(uuid())
  nombre     String
  slug       String       @unique
  logoUrl    String?      @map("logo_url")
  activo     Boolean      @default(true)
  createdAt  DateTime     @default(now()) @map("created_at")

  restaurantes Restaurante[]
  membresias   Membresia[]

  @@map("marca")
}

model Restaurante {
  id          String   @id @default(uuid())
  marcaId     String   @map("marca_id")
  nombre      String
  direccion   String?
  logoUrl     String?  @map("logo_url")
  modoSesion  String   @default("abierto") @map("modo_sesion")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  nombreSeccionRecomendados String @default("RECOMENDACIONES") @map("nombre_seccion_recomendados")

  marca         Marca              @relation(fields: [marcaId], references: [id])
  mozos         Mozo[]
  comandas      Comanda[]
  categorias    CategoriaMenu[]
  menus         Menu[]
  mesas         Mesa[]
  ingredientes  Ingrediente[]
  items         ItemMenu[]
  membresias    Membresia[]

  mpAccessToken     String?   @map("mp_access_token")
  mpRefreshToken    String?   @map("mp_refresh_token")
  mpUserId          String?   @map("mp_user_id")
  mpTokenExpiresAt  DateTime? @map("mp_token_expires_at")

  @@map("restaurante")
}

// ─────────────────────────────────────────────
// USUARIOS DEL SISTEMA
// ─────────────────────────────────────────────

// Historial de acciones de ROOT (docs/plan-consola-root.md, 7.2). Solo se agregan filas: la base bloquea UPDATE, DELETE y
// TRUNCATE con disparadores (migración 20261020150000). A propósito NO tiene claves foráneas: guarda copias (email, nombre) de
// quién y sobre qué, así que retirar una cuenta o una marca no toca el historial. Nunca guarda una contraseña ni un hash.
model HistorialRoot {
  id            Int      @id @default(autoincrement())
  // La hora la pone la base: un disparador BEFORE INSERT pisa lo que mande el cliente con now().
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  // ROOT: lo hizo una cuenta ROOT desde la consola. SCRIPT: lo hizo una persona con scripts/cuentas-root.ts.
  actorTipo     String   @map("actor_tipo")
  actorId       String?  @map("actor_id")
  // Email del ROOT en ese momento; si fue el script, el usuario del sistema operativo de quien lo corrió.
  actorNombre   String   @map("actor_nombre")
  accion        String
  // MARCA | RESTAURANTE | OWNER | ROOT
  entidadTipo   String   @map("entidad_tipo")
  entidadId     String   @map("entidad_id")
  // Nombre (marca, restaurante) o email (cuentas) en ese momento.
  entidadNombre String   @map("entidad_nombre")
  // La marca de contexto (para un restaurante o un dueño).
  marcaId       String?  @map("marca_id")
  marcaNombre   String?  @map("marca_nombre")
  // Lista de { campo, antes, despues }.
  detalle       Json     @default("[]")

  @@index([createdAt])
  @@index([entidadTipo, entidadId])
  @@map("historial_root")
}

model Mozo {
  id            String   @id @default(uuid())
  restauranteId String   @map("restaurante_id")
  nombre        String
  email         String?
  telefono      String?
  activo        Boolean  @default(true)
  esJefeSalon   Boolean  @default(false) @map("es_jefe_salon")
  createdAt     DateTime @default(now()) @map("created_at")
  // Usuario de Supabase dueño de este perfil. Null en los que quedaron del login anterior, que se retiró en la Fase 5.
  usuarioId     String?  @map("usuario_id")

  restaurante   Restaurante      @relation(fields: [restauranteId], references: [id])
  usuario       Usuario?         @relation(fields: [usuarioId], references: [id])
  asignaciones  AsignacionMesa[]
  llamados      LlamadoMozo[]
  mozoMesas     MozoMesa[]
  ediciones     PedidoEdicion[]
  pagos         Pago[]

  @@unique([usuarioId, restauranteId])
  @@map("mozo")
}

// ─────────────────────────────────────────────
// MESAS Y SESIONES
// ─────────────────────────────────────────────

model Mesa {
  id            String   @id @default(uuid())
  restauranteId String   @map("restaurante_id")
  numero        String
  qrToken       String   @unique @map("qr_token")
  pin           String
  estado        String   @default("libre")
  activo        Boolean  @default(true)

  restaurante  Restaurante      @relation(fields: [restauranteId], references: [id])
  sesiones     SesionMesa[]
  pedidos      Pedido[]
  asignaciones AsignacionMesa[]
  mozoMesas    MozoMesa[]

  @@unique([restauranteId, pin])
  @@map("mesa")
}

model MozoMesa {
  id       String   @id @default(uuid())
  mesaId   String   @map("mesa_id")
  mozoId   String   @map("mozo_id")
  creadoEn DateTime @default(now()) @map("creado_en")

  mesa Mesa @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  mozo Mozo @relation(fields: [mozoId], references: [id], onDelete: Cascade)

  @@unique([mesaId, mozoId])
  @@map("mozo_mesa")
}

model Cliente {
  id           String   @id @default(uuid())
  nombre       String
  email        String?  @unique
  telefono     String?
  createdAt    DateTime @default(now()) @map("created_at")
  // Cuenta opcional del cliente en Supabase Auth.
  supabaseUserId String? @unique @map("supabase_user_id") @db.Uuid

  sesiones       SesionMesa[]
  sesionClientes SesionMesaCliente[]
  pedidoItems    PedidoItem[]
  comensales     Comensal[]

  @@map("cliente")
}

model SesionMesa {
  id            String    @id @default(uuid())
  mesaId        String    @map("mesa_id")
  clienteId     String?   @map("cliente_id")
  codigoSesion  String    @map("codigo_sesion")
  iniciadaEn    DateTime  @default(now()) @map("iniciada_en")
  cerradaEn     DateTime? @map("cerrada_en")
  estado        String    @default("activa")

  mesa          Mesa               @relation(fields: [mesaId], references: [id])
  cliente       Cliente?           @relation(fields: [clienteId], references: [id])
  pedidos       Pedido[]
  asignaciones  AsignacionMesa[]
  llamados      LlamadoMozo[]
  participantes SesionMesaCliente[]
  comensales    Comensal[]
  pagos         Pago[]

  @@map("sesion_mesa")
}

model SesionMesaCliente {
  id          String   @id @default(uuid())
  sesionId    String   @map("sesion_id")
  clienteId   String   @map("cliente_id")
  orden       Int
  ingresadoEn DateTime @default(now()) @map("ingresado_en")

  sesion  SesionMesa @relation(fields: [sesionId], references: [id])
  cliente Cliente    @relation(fields: [clienteId], references: [id])

  @@unique([sesionId, clienteId])
  @@map("sesion_mesa_cliente")
}

model AsignacionMesa {
  id          String    @id @default(uuid())
  mesaId      String    @map("mesa_id")
  mozoId      String    @map("mozo_id")
  sesionId    String    @map("sesion_id")
  origen      String
  asignadoEn  DateTime  @default(now()) @map("asignado_en")
  liberadoEn  DateTime? @map("liberado_en")

  mesa   Mesa       @relation(fields: [mesaId], references: [id])
  mozo   Mozo       @relation(fields: [mozoId], references: [id])
  sesion SesionMesa @relation(fields: [sesionId], references: [id])

  @@map("asignacion_mesa")
}

// ─────────────────────────────────────────────
// LLAMADOS (tiempo real, con persistencia mínima)
// ─────────────────────────────────────────────

model LlamadoMozo {
  id        String   @id @default(uuid())
  sesionId  String   @map("sesion_id")
  mozoId    String?  @map("mozo_id")
  estado    String   @default("pendiente")
  motivo    String?  @default("general")  @map("motivo")
  createdAt DateTime @default(now()) @map("created_at")

  sesion SesionMesa @relation(fields: [sesionId], references: [id])
  mozo   Mozo?      @relation(fields: [mozoId], references: [id])

  @@map("llamado_mozo")
}

// ─────────────────────────────────────────────
// MENÚ
// ─────────────────────────────────────────────

model Comanda {
  id            String @id @default(uuid())
  restauranteId String @map("restaurante_id")
  nombre        String

  restaurante Restaurante @relation(fields: [restauranteId], references: [id])
  items       ItemMenu[]

  @@map("comanda")
}

model CategoriaMenu {
  id            String @id @default(uuid())
  restauranteId String @map("restaurante_id")
  nombre        String
  orden         Int    @default(0)

  restaurante   Restaurante      @relation(fields: [restauranteId], references: [id])
  subcategorias SubcategoriaMenu[]
  items         ItemMenu[]

  @@map("categoria_menu")
}

model SubcategoriaMenu {
  id          String @id @default(uuid())
  categoriaId String @map("categoria_id")
  nombre      String
  orden       Int    @default(0)

  categoria CategoriaMenu @relation(fields: [categoriaId], references: [id])
  items     ItemMenu[]

  @@map("subcategoria_menu")
}

model ItemMenu {
  id                String   @id @default(uuid())
  restauranteId     String   @map("restaurante_id")
  categoriaId       String?  @map("categoria_id")
  subcategoriaId    String?  @map("subcategoria_id")
  comandaId         String?  @map("comanda_id")
  nombre            String
  descripcion       String?
  precioBase        Decimal  @map("precio_base") @db.Decimal(10, 2)
  // Precio con descuento en pesos enteros. El porcentaje no se guarda: se calcula. El CHECK
  // (0 < precio_descuento < precio_base) vive en la migración, porque Prisma no lo puede expresar.
  precioDescuento   Int?     @map("precio_descuento")
  disponible        Boolean  @default(true)
  recomendadoEn     DateTime? @map("recomendado_en")
  imagenUrl         String?  @map("imagen_url")

  restaurante    Restaurante        @relation(fields: [restauranteId], references: [id])
  categoria      CategoriaMenu?     @relation(fields: [categoriaId], references: [id])
  subcategoria   SubcategoriaMenu?  @relation(fields: [subcategoriaId], references: [id])
  comanda        Comanda?           @relation(fields: [comandaId], references: [id])
  menus          MenuItem[]
  ingredientes   ItemIngrediente[]
  clasificaciones ItemClasificacion[]
  pedidoItems    PedidoItem[]

  @@map("item_menu")
}


model Menu {
  id            String  @id @default(uuid())
  restauranteId String  @map("restaurante_id")
  nombre        String
  dias          String?
  horaInicio    String? @map("hora_inicio")
  horaFin       String? @map("hora_fin")
  temporada     String?

  restaurante Restaurante @relation(fields: [restauranteId], references: [id])
  items       MenuItem[]

  @@map("menu")
}

model MenuItem {
  menuId String @map("menu_id")
  itemId String @map("item_id")

  menu Menu     @relation(fields: [menuId], references: [id])
  item ItemMenu @relation(fields: [itemId], references: [id])

  @@id([menuId, itemId])
  @@map("menu_item")
}

model ClasificacionDieta {
  id     String @id @default(uuid())
  nombre String @unique

  items ItemClasificacion[]

  @@map("clasificacion_dieta")
}

model ItemClasificacion {
  itemId           String @map("item_id")
  clasificacionId  String @map("clasificacion_id")

  item          ItemMenu           @relation(fields: [itemId], references: [id])
  clasificacion ClasificacionDieta @relation(fields: [clasificacionId], references: [id])

  @@id([itemId, clasificacionId])
  @@map("item_clasificacion")
}

model Ingrediente {
  id            String  @id @default(uuid())
  restauranteId String  @map("restaurante_id")
  nombre        String
  esAlergeno    Boolean @default(false) @map("es_alergeno")

  restaurante Restaurante       @relation(fields: [restauranteId], references: [id])
  items       ItemIngrediente[]

  @@map("ingrediente")
}

model ItemIngrediente {
  id            String  @id @default(uuid())
  itemId        String  @map("item_id")
  ingredienteId String  @map("ingrediente_id")
  esOriginal    Boolean @map("es_original")
  cantidad      Decimal @db.Decimal(10, 3)
  esRemovible   Boolean @default(false) @map("es_removible")
  esAgregable   Boolean @default(false) @map("es_agregable")
  precioExtra   Decimal @default(0) @map("precio_extra") @db.Decimal(10, 2)
  cantidadMin   Int     @default(0) @map("cantidad_min")
  cantidadMax   Int     @default(1) @map("cantidad_max")

  item        ItemMenu          @relation(fields: [itemId], references: [id])
  ingrediente Ingrediente       @relation(fields: [ingredienteId], references: [id])
  mods        PedidoItemMod[]

  @@unique([itemId, ingredienteId])
  @@map("item_ingrediente")
}

// ─────────────────────────────────────────────
// PEDIDOS Y PAGOS
// ─────────────────────────────────────────────

model Pedido {
  id        String   @id @default(uuid())
  sesionId  String   @map("sesion_id")
  mesaId    String   @map("mesa_id")
  estado    String   @default("pendiente")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sesion    SesionMesa     @relation(fields: [sesionId], references: [id])
  mesa      Mesa           @relation(fields: [mesaId], references: [id])
  items     PedidoItem[]
  ediciones PedidoEdicion[]

  @@map("pedido")
}

model PedidoItem {
  id              String   @id @default(uuid())
  pedidoId        String   @map("pedido_id")
  itemId          String   @map("item_id")
  clienteId       String?  @map("cliente_id")
  cantidad        Int
  cantidadEditada Int?     @map("cantidad_editada")
  precioUnitario  Decimal  @map("precio_unitario") @db.Decimal(10, 2)
  notas           String?

  pedido  Pedido          @relation(fields: [pedidoId], references: [id])
  item    ItemMenu        @relation(fields: [itemId], references: [id])
  cliente Cliente?        @relation(fields: [clienteId], references: [id])
  mods    PedidoItemMod[]
  asignaciones ItemComensal[]

  @@map("pedido_item")
}

model PedidoItemMod {
  pedidoItemId      String  @map("pedido_item_id")
  itemIngredienteId String  @map("item_ingrediente_id")
  accion            String
  cantidad          Decimal @db.Decimal(10, 3)

  pedidoItem     PedidoItem     @relation(fields: [pedidoItemId], references: [id])
  itemIngrediente ItemIngrediente @relation(fields: [itemIngredienteId], references: [id])

  @@id([pedidoItemId, itemIngredienteId])
  @@map("pedido_item_mod")
}

model PedidoEdicion {
  id            String   @id @default(uuid())
  pedidoId      String   @map("pedido_id")
  mozoId        String?  @map("mozo_id")
  // Quien editó, con su cuenta de Supabase. Null en las ediciones anteriores a la Fase 4 cuyo admin no llegó a tener
  // cuenta: la Fase 5 pasó a usuarioId las que sí (mismo email) y borró la columna admin_id.
  usuarioId     String?  @map("usuario_id")
  justificacion String
  creadoEn      DateTime @default(now()) @map("creado_en")

  itemsEliminados PedidoEdicionItem[]
  pedido          Pedido  @relation(fields: [pedidoId], references: [id])
  mozo            Mozo?   @relation(fields: [mozoId], references: [id])
  usuario         Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("pedido_edicion")
}

model PedidoEdicionItem {
  id              String  @id @default(uuid())
  edicionId       String  @map("edicion_id")
  pedidoItemId    String  @map("pedido_item_id")
  itemNombre      String  @map("item_nombre")
  cantidadAntes   Int     @map("cantidad_antes")
  cantidadDespues Int     @map("cantidad_despues")
  precioUnitario  Decimal @db.Decimal(10,2) @map("precio_unitario")

  edicion PedidoEdicion @relation(fields: [edicionId], references: [id])

  @@map("pedido_edicion_item")
}

model Pago {
  id                String    @id @default(uuid())
  sesionId          String    @map("sesion_id")
  monto             Decimal   @db.Decimal(10, 2)
  metodo            String
  estado            String    @default("pendiente")
  referenciaExterna String?   @map("referencia_externa")
  mozoId            String?   @map("mozo_id")
  // La cuenta de Supabase de quien registró el cobro (Fase 4 de auth).
  usuarioId         String?   @map("usuario_id")
  cobradoPorNombre  String?   @map("cobrado_por_nombre")
  fechaCobro        DateTime? @map("fecha_cobro") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at")

  sesion   SesionMesa @relation(fields: [sesionId], references: [id])
  mozo     Mozo?      @relation(fields: [mozoId], references: [id])
  usuario  Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("pago")
}

// ─────────────────────────────────────────────
// COMENSALES (split de cuenta por persona en la mesa)
// ─────────────────────────────────────────────

model Comensal {
  id                  String   @id @default(uuid())
  sesionId            String   @map("sesion_id")
  clienteId           String?  @map("cliente_id")
  nombre              String
  nombreNormalizado   String   @map("nombre_normalizado")
  esOwner             Boolean  @default(false) @map("es_owner")
  creadoPorComensalId String?  @map("creado_por_comensal_id")
  createdAt           DateTime @default(now()) @map("created_at")

  sesion     SesionMesa     @relation(fields: [sesionId], references: [id])
  cliente    Cliente?       @relation(fields: [clienteId], references: [id])
  items      ItemComensal[]

  @@unique([sesionId, nombreNormalizado])
  @@map("comensal")
}

model ItemComensal {
  id           String   @id @default(uuid())
  pedidoItemId String   @map("pedido_item_id")
  comensalId   String   @map("comensal_id")
  createdAt    DateTime @default(now()) @map("created_at")

  pedidoItem   PedidoItem @relation(fields: [pedidoItemId], references: [id])
  comensal     Comensal   @relation(fields: [comensalId], references: [id])

  @@unique([pedidoItemId, comensalId])
  @@map("item_comensal")
}

// ─────────────────────────────────────────────
// AUTENTICACIÓN (SUPABASE) Y PERMISOS — docs/auth/specs/auth.md
// ─────────────────────────────────────────────

enum Rol {
  OWNER
  GERENTE
  JEFE_SALON
  MOZO
  COCINA

  @@map("rol")
}

// Supabase Auth dice quién es; Usuario y Membresia dicen qué puede hacer. ROOT no es una
// membresía: es esRoot.
model Usuario {
  id             String   @id @default(uuid())
  supabaseUserId String   @unique @map("supabase_user_id") @db.Uuid
  email          String   @unique
  nombre         String
  activo         Boolean  @default(true)
  esRoot         Boolean  @default(false) @map("es_root")
  createdAt      DateTime @default(now()) @map("created_at")

  membresias Membresia[]
  mozos      Mozo[]
  ediciones  PedidoEdicion[]
  cobros     Pago[]

  @@map("usuario")
}

// OWNER se asocia a una marca; GERENTE, JEFE_SALON, MOZO y COCINA, a un restaurante. El CHECK
// que lo garantiza vive en la migración, porque Prisma no lo puede expresar.
model Membresia {
  id            String   @id @default(uuid())
  usuarioId     String   @map("usuario_id")
  rol           Rol
  marcaId       String?  @map("marca_id")
  restauranteId String?  @map("restaurante_id")
  createdAt     DateTime @default(now()) @map("created_at")

  usuario     Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  marca       Marca?       @relation(fields: [marcaId], references: [id], onDelete: Cascade)
  restaurante Restaurante? @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, restauranteId])
  @@unique([usuarioId, marcaId])
  @@index([restauranteId])
  @@index([marcaId])
  @@map("membresia")
}
