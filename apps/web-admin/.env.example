# web-admin (docs/auth/specs/auth.md, Fase 4). Copiar a .env.local, que git ignora.
# Valores de staging y producción: docs/auth/VariablesACambiar.md.

# API. Por defecto /api, que el servidor de Vite reenvía a BACKEND_URL (http://localhost:3000 si no se define).
VITE_API_URL=/api

# Proyecto de Supabase (Project Settings → API). La publishable key es pública: va en el bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Dominio de la cookie de sesión compartida con las otras apps (.menyu.local en local). Vacío: solo este host.
VITE_AUTH_COOKIE_DOMAIN=.menyu.local

# web-auth: a dónde va quien no tiene sesión y de dónde vuelve después de iniciarla.
VITE_AUTH_URL=http://auth.menyu.local:5173
