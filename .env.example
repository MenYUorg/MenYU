# Base de datos
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public"

# JWT
JWT_SECRET="cambia-esto-en-produccion"

# Supabase
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Mercado Pago (OAuth por restaurante). Detalle de cada variable: apps/backend/.env.example.
# Clave AES-256-GCM con la que CryptoService cifra los tokens OAuth de cada restaurante.
MP_ENCRYPTION_KEY=cambia-esto-por-un-secret-largo-y-aleatorio
# Credenciales de la app de Mercado Pago (no hay un MP_ACCESS_TOKEN global).
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# También las usa Mercado Pago: BASE_URL (redirect_uri del OAuth y notification_url del webhook),
# FRONTEND_URL (back_urls de respaldo) y FRONTEND_ADMIN_URL (vuelta al panel después de conectar).
